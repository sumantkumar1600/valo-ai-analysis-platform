# =========================================================================
# VALO Investment Research Agent - Environment Template
# Duplicate this file as ".env" and fill in your private API credentials.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Database Configuration
# -------------------------------------------------------------------------
# DATABASE_URL: Local SQLite path for dev history persistence.
# For production deployments (e.g. Vercel), replace with a Supabase or Neon PostgreSQL URL.
DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------------------
# 2. Large Language Model (LLM) Credentials
# -------------------------------------------------------------------------
# OPENAI_API_KEY: Key for GPT-4o-mini processing of reports and summaries.
# Alternatively, you can configure GEMINI_API_KEY.
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# -------------------------------------------------------------------------
# 3. Web Search Providers
# -------------------------------------------------------------------------
# TAVILY_API_KEY: Required for semantic news scrapers and agent search tools.
# Obtain a free key from https://tavily.com
TAVILY_API_KEY="your-tavily-api-key-here"

# -------------------------------------------------------------------------
# 4. Financial Data Providers
# -------------------------------------------------------------------------
# ALPHAVANTAGE_API_KEY: Essential for annual income, balance sheet, and metrics history.
# Get a free key from https://www.alphavantage.co
ALPHAVANTAGE_API_KEY="your-alpha-vantage-api-key-here"
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key-here"

# -------------------------------------------------------------------------
# 5. LangGraph & LangChain Tracing (Optional)
# -------------------------------------------------------------------------
# Configures agent diagnostics tracing inside LangSmith.
# LANGCHAIN_TRACING_V2: Set to "true" to activate trace logs.
# LANGCHAIN_API_KEY: API key from https://smith.langchain.com
# LANGCHAIN_PROJECT: Log categorization bucket identifier.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY="your-langchain-api-key-here"
LANGCHAIN_PROJECT="valo-investment-agent"

# -------------------------------------------------------------------------
# 6. Next.js Application Settings
# -------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL: Base client domain reference for SSR layouts.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
